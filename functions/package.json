{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No functions tests yet\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase --config ../firebase/firebase.json emulators:start --only functions",
    "shell": "npm run build && firebase --config ../firebase/firebase.json functions:shell",
    "start": "npm run shell",
    "deploy": "firebase --config ../firebase/firebase.json deploy --only functions",
    "logs": "firebase --config ../firebase/firebase.json functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
