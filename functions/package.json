{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase --config ../firebase.json emulators:start --only functions",
    "shell": "npm run build && firebase --config ../firebase.json functions:shell",
    "start": "npm run shell",
    "deploy": "firebase --config ../firebase.json deploy --only functions",
    "deploy:operator-backend": "npm run build && cd .. && firebase --config firebase.json deploy --only functions,firestore",
    "logs": "firebase --config ../firebase.json functions:log",
    "set-platform-admin": "node scripts/setPlatformAdminClaim.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^4.9.0"
  },
  "private": true
}
