{
  "name": "bcup-firebase-local",
  "private": true,
  "scripts": {
    "emu:start": "firebase --config ../firebase.json emulators:start --project bitchcup-dev",
    "emu:start:only": "firebase --config ../firebase.json emulators:start --project bitchcup-dev --only auth,firestore,storage",
    "emu:export": "firebase --config ../firebase.json emulators:export ./emulator-data",
    "emu:start:import": "firebase --config ../firebase.json emulators:start --project bitchcup-dev --import ./emulator-data --export-on-exit"
  }
}
