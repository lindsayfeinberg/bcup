rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Assumption for rules:
     * - profileId == request.auth.uid
     * - membership doc id = "{communityId}_{profileId}"
     *
     * If you use UUID profile IDs instead, add a profile->uid mapping strategy
     * that can be checked in rules.
     */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwnProfile(profileId) {
      return signedIn() && uid() == profileId;
    }

    function membershipIdFor(communityId, profileId) {
      return communityId + "_" + profileId;
    }

    function isCommunityMember(communityId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/memberships/$(membershipIdFor(communityId, uid()))
        );
    }

    function keysOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function hasProfileKeys() {
      return keysOnly([
        "id",
        "googleAuthId",
        "displayName",
        "profilePhotoUrl",
        "overallOdds",
        "overallGamesPlayed",
        "ageConfirmed21PlusAt",
        "onboardingCompleteAt",
        "createdAt",
        "updatedAt"
      ]);
    }

    // Callable-created communities include memberCount; older docs may omit it until backfilled.
    function hasCommunityKeys() {
      return request.resource.data.keys().hasOnly([
        "id",
        "name",
        "createdByProfileId",
        "inviteCode",
        "inviteLink",
        "createdAt",
        "updatedAt"
      ]) || request.resource.data.keys().hasOnly([
        "id",
        "name",
        "createdByProfileId",
        "inviteCode",
        "inviteLink",
        "memberCount",
        "createdAt",
        "updatedAt"
      ]);
    }

    function communityMemberCountPreserved() {
      return (!resource.data.keys().hasAny(["memberCount"]) && !request.resource.data.keys().hasAny(["memberCount"])) ||
        request.resource.data.memberCount == resource.data.memberCount;
    }

    function hasGameLogKeys() {
      return keysOnly([
        "id",
        "communityId",
        "bracketId",
        "bracketMatchId",
        "gameType",
        "createdByProfileId",
        "participantProfileIds",
        "winnerProfileIds",
        "loserProfileIds",
        "mvpProfileId",
        "lvpProfileId",
        "photoUrls",
        "notes",
        "pongStats",
        "beerBallStats",
        "battlePongStats",
        "baseballStats",
        "createdAt",
        "updatedAt"
      ]);
    }

    // MVP/LVP optional; when set must be a participant and must differ from each other.
    function gameLogMvpLvpValid(data) {
      let mvpOk = !data.keys().hasAny(["mvpProfileId"]) ||
        data.mvpProfileId == null ||
        (data.mvpProfileId is string && data.participantProfileIds.hasAny([data.mvpProfileId]));
      let lvpOk = !data.keys().hasAny(["lvpProfileId"]) ||
        data.lvpProfileId == null ||
        (data.lvpProfileId is string && data.participantProfileIds.hasAny([data.lvpProfileId]));
      // Avoid reading mvp/lvp when keys are absent (undefined throws).
      let notSame = !data.keys().hasAny(["mvpProfileId"]) ||
        !data.keys().hasAny(["lvpProfileId"]) ||
        data.mvpProfileId == null ||
        data.lvpProfileId == null ||
        data.mvpProfileId != data.lvpProfileId;
      return mvpOk && lvpOk && notSame;
    }

    // Optional bracket linkage:
    // - either both keys are absent
    // - or both keys are present as non-empty strings
    // Client must not set only one of the two.
    function gameLogBracketLinkValid(data) {
      let hasBracketId = data.keys().hasAny(["bracketId"]);
      let hasBracketMatchId = data.keys().hasAny(["bracketMatchId"]);
      return (!hasBracketId && !hasBracketMatchId) ||
        (hasBracketId && hasBracketMatchId &&
          data.bracketId is string && data.bracketId != "" &&
          data.bracketMatchId is string && data.bracketMatchId != "");
    }

    // V1 rule: bracket linkage is immutable after creation.
    // Deny adding or removing bracket keys via update.
    function gameLogBracketImmutabilityValid() {
      let resourceHas = resource.data.keys().hasAny(["bracketId"]);
      let requestHas = request.resource.data.keys().hasAny(["bracketId"]);
      return resourceHas == requestHas &&
        (!requestHas ||
          (request.resource.data.bracketId == resource.data.bracketId &&
            request.resource.data.bracketMatchId == resource.data.bracketMatchId));
    }

    function hasBracketKeys() {
      return keysOnly([
        "id",
        "communityId",
        "participantProfileIds",
        "seedMethod",
        "teamSize",
        "status",
        "rounds",
        "createdAt",
        "updatedAt"
      ]);
    }

    match /profiles/{profileId} {
      allow read: if isOwnProfile(profileId);

      // Client can create/update own profile but cannot set server-owned fields.
      allow create: if isOwnProfile(profileId) &&
        hasProfileKeys() &&
        request.resource.data.id == profileId &&
        request.resource.data.googleAuthId == uid() &&
        request.resource.data.overallOdds == 0 &&
        request.resource.data.overallGamesPlayed == 0;

      allow update: if isOwnProfile(profileId) &&
        hasProfileKeys() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.googleAuthId == resource.data.googleAuthId &&
        request.resource.data.overallOdds == resource.data.overallOdds &&
        request.resource.data.overallGamesPlayed == resource.data.overallGamesPlayed &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /communities/{communityId} {
      allow read: if isCommunityMember(communityId);

      // Created only by Cloud Functions (Admin SDK) so joins can enforce caps atomically.
      allow create: if false;

      // Creator may edit display name; memberCount changes only via Admin (e.g. join callable).
      allow update: if signedIn() &&
        hasCommunityKeys() &&
        isCommunityMember(communityId) &&
        resource.data.createdByProfileId == uid() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.resource.data.inviteLink == resource.data.inviteLink &&
        communityMemberCountPreserved();

      allow delete: if false;
    }

    match /memberships/{membershipId} {
      // User can read only their own membership docs.
      allow read: if signedIn() && (
        resource.data.profileId == uid() || isCommunityMember(resource.data.communityId)
      );

      // Membership rows are created only by Cloud Functions (Admin SDK).
      allow create: if false;

      // Client cannot mutate membership once created (server can via Admin SDK).
      allow update, delete: if false;
    }

    match /gameLogs/{gameLogId} {
      allow read: if isCommunityMember(resource.data.communityId);

      allow create: if signedIn() &&
        hasGameLogKeys() &&
        gameLogBracketLinkValid(request.resource.data) &&
        gameLogMvpLvpValid(request.resource.data) &&
        request.resource.data.id == gameLogId &&
        request.resource.data.createdByProfileId == uid() &&
        isCommunityMember(request.resource.data.communityId) &&
        request.resource.data.winnerProfileIds.size() > 0 &&
        request.resource.data.loserProfileIds.size() > 0 &&
        request.resource.data.photoUrls.size() == 1;

      // Only log creator can update/delete.
      allow update: if signedIn() &&
        hasGameLogKeys() &&
        gameLogBracketLinkValid(request.resource.data) &&
        gameLogBracketImmutabilityValid() &&
        gameLogMvpLvpValid(request.resource.data) &&
        isCommunityMember(resource.data.communityId) &&
        resource.data.createdByProfileId == uid() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.winnerProfileIds.size() > 0 &&
        request.resource.data.loserProfileIds.size() > 0 &&
        request.resource.data.photoUrls.size() == 1;

      allow delete: if signedIn() &&
        isCommunityMember(resource.data.communityId) &&
        resource.data.createdByProfileId == uid();
    }

    match /brackets/{bracketId} {
      allow read: if isCommunityMember(resource.data.communityId);

      allow create: if signedIn() &&
        hasBracketKeys() &&
        request.resource.data.id == bracketId &&
        isCommunityMember(request.resource.data.communityId);

      // Updates allowed only for community members.
      allow update: if signedIn() &&
        hasBracketKeys() &&
        isCommunityMember(resource.data.communityId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }
  }
}
