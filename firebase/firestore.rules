rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Assumption for rules:
     * - profileId == request.auth.uid
     * - membership doc id = "{communityId}_{profileId}"
     *
     * If you use UUID profile IDs instead, add a profile->uid mapping strategy
     * that can be checked in rules.
     */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function isOwnProfile(profileId) {
      return signedIn() && uid() == profileId;
    }

    function membershipIdFor(communityId, profileId) {
      return communityId + "_" + profileId;
    }

    function isCommunityMember(communityId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/memberships/$(membershipIdFor(communityId, uid()))
        );
    }

    // Set by Admin when creator hides a league; blocks reads of other members' roster rows and league content.
    function currentUserLeagueHiddenFromMembers(communityId) {
      let mid = membershipIdFor(communityId, uid());
      return exists(/databases/$(database)/documents/memberships/$(mid)) &&
        get(/databases/$(database)/documents/memberships/$(mid)).data.keys().hasAny(['leagueHiddenForMember']) &&
        get(/databases/$(database)/documents/memberships/$(mid)).data.leagueHiddenForMember == true;
    }

    function keysOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function hasProfileKeys() {
      return keysOnly([
        "id",
        "googleAuthId",
        "displayName",
        "profilePhotoUrl",
        "overallOdds",
        "overallGamesPlayed",
        "overallOddsByGameType",
        "overallGamesPlayedByGameType",
        "ageConfirmed21PlusAt",
        "onboardingCompleteAt",
        "createdAt",
        "updatedAt"
      ]);
    }

    // Clients must not set server-owned per–game-type maps on create.
    function profileCreateOmitsServerOddsMaps() {
      return !request.resource.data.keys().hasAny(["overallOddsByGameType"]) &&
        !request.resource.data.keys().hasAny(["overallGamesPlayedByGameType"]);
    }

    // Once present (via Admin), per–game-type maps cannot be added or changed by the client.
    function profileUpdateServerOddsMapsImmutable() {
      let oddsOk = (!resource.data.keys().hasAny(["overallOddsByGameType"]) &&
        !request.resource.data.keys().hasAny(["overallOddsByGameType"])) ||
        request.resource.data.overallOddsByGameType == resource.data.overallOddsByGameType;
      let gamesOk = (!resource.data.keys().hasAny(["overallGamesPlayedByGameType"]) &&
        !request.resource.data.keys().hasAny(["overallGamesPlayedByGameType"])) ||
        request.resource.data.overallGamesPlayedByGameType == resource.data.overallGamesPlayedByGameType;
      return oddsOk && gamesOk;
    }

    // Callable-created communities include memberCount; optional hiddenFromMembers toggled only via Admin/callable.
    function hasCommunityDocumentKeys() {
      return request.resource.data.keys().hasOnly([
        "id",
        "name",
        "createdByProfileId",
        "inviteCode",
        "inviteLink",
        "memberCount",
        "hiddenFromMembers",
        "createdAt",
        "updatedAt"
      ]);
    }

    function communityHiddenPreserved() {
      return (!resource.data.keys().hasAny(['hiddenFromMembers']) && !request.resource.data.keys().hasAny(['hiddenFromMembers'])) ||
        request.resource.data.hiddenFromMembers == resource.data.hiddenFromMembers;
    }

    function communityMemberCountPreserved() {
      return (!resource.data.keys().hasAny(["memberCount"]) && !request.resource.data.keys().hasAny(["memberCount"])) ||
        request.resource.data.memberCount == resource.data.memberCount;
    }

    function hasGameLogKeys() {
      return keysOnly([
        "id",
        "communityId",
        "bracketId",
        "bracketMatchId",
        "gameType",
        "customGameDefinitionId",
        "customGameDefinitionName",
        "createdByProfileId",
        "participantProfileIds",
        "winnerProfileIds",
        "loserProfileIds",
        "mvpProfileId",
        "lvpProfileId",
        "photoUrls",
        "notes",
        "pongStats",
        "beerBallStats",
        "battlePongStats",
        "baseballStats",
        "crossfireStats",
        "createdAt",
        "updatedAt"
      ]);
    }

    // Phase E2: built-in `gameType` OR sentinel `CUSTOM` + `customGameDefinitionId`.
    function gameLogIsBuiltinGameType(gt) {
      return gt == "PONG" || gt == "BEER_BALL" || gt == "BATTLE_PONG" ||
        gt == "BASEBALL" || gt == "CROSSFIRE";
    }

    function gameLogIsAllowedGameType(gt) {
      return gameLogIsBuiltinGameType(gt) || gt == "CUSTOM";
    }

    function gameLogCustomDefIdPresent(data) {
      return data.keys().hasAny(["customGameDefinitionId"]) &&
        data.customGameDefinitionId is string &&
        data.customGameDefinitionId.size() > 0 &&
        data.customGameDefinitionId.size() <= 128;
    }

    function gameLogCustomDefinitionNameValid(data) {
      return !data.keys().hasAny(["customGameDefinitionName"]) ||
        data.customGameDefinitionName == null ||
        (data.customGameDefinitionName is string &&
          data.customGameDefinitionName.size() > 0 &&
          data.customGameDefinitionName.size() <= 80);
    }

    function gameLogGameTypeAndCustomValid(data) {
      return data.gameType is string &&
        gameLogIsAllowedGameType(data.gameType) &&
        (data.gameType != "CUSTOM" || gameLogCustomDefIdPresent(data)) &&
        (gameLogIsBuiltinGameType(data.gameType) ?
          (!data.keys().hasAny(["customGameDefinitionId"]) ||
            data.customGameDefinitionId == null) :
          true) &&
        (gameLogIsBuiltinGameType(data.gameType) ?
          (!data.keys().hasAny(["customGameDefinitionName"]) ||
            data.customGameDefinitionName == null) :
          gameLogCustomDefinitionNameValid(data));
    }

    function gameLogCustomDefIdValue(data) {
      return !data.keys().hasAny(["customGameDefinitionId"]) ?
        null :
        data.customGameDefinitionId;
    }

    function gameLogCustomDefinitionNameValue(data) {
      return !data.keys().hasAny(["customGameDefinitionName"]) ?
        null :
        data.customGameDefinitionName;
    }

    function gameLogGameTypeAndCustomImmutableOnUpdate() {
      return request.resource.data.gameType == resource.data.gameType &&
        gameLogCustomDefIdValue(request.resource.data) ==
        gameLogCustomDefIdValue(resource.data) &&
        gameLogCustomDefinitionNameValue(request.resource.data) ==
        gameLogCustomDefinitionNameValue(resource.data);
    }

    // MVP/LVP optional; when set must be a participant and must differ from each other.
    function gameLogMvpLvpValid(data) {
      let mvpOk = !data.keys().hasAny(["mvpProfileId"]) ||
        data.mvpProfileId == null ||
        (data.mvpProfileId is string && data.participantProfileIds.hasAny([data.mvpProfileId]));
      let lvpOk = !data.keys().hasAny(["lvpProfileId"]) ||
        data.lvpProfileId == null ||
        (data.lvpProfileId is string && data.participantProfileIds.hasAny([data.lvpProfileId]));
      // Avoid reading mvp/lvp when keys are absent (undefined throws).
      let notSame = !data.keys().hasAny(["mvpProfileId"]) ||
        !data.keys().hasAny(["lvpProfileId"]) ||
        data.mvpProfileId == null ||
        data.lvpProfileId == null ||
        data.mvpProfileId != data.lvpProfileId;
      return mvpOk && lvpOk && notSame;
    }

    // Optional bracket linkage:
    // - either both keys are absent
    // - or both keys are present as non-empty strings
    // Client must not set only one of the two.
    function gameLogBracketLinkValid(data) {
      let hasBracketId = data.keys().hasAny(["bracketId"]);
      let hasBracketMatchId = data.keys().hasAny(["bracketMatchId"]);
      return (!hasBracketId && !hasBracketMatchId) ||
        (hasBracketId && hasBracketMatchId &&
          data.bracketId is string && data.bracketId != "" &&
          data.bracketMatchId is string && data.bracketMatchId != "");
    }

    // V1 rule: bracket linkage is immutable after creation.
    // Deny adding or removing bracket keys via update.
    function gameLogBracketImmutabilityValid() {
      let resourceHas = resource.data.keys().hasAny(["bracketId"]);
      let requestHas = request.resource.data.keys().hasAny(["bracketId"]);
      return resourceHas == requestHas &&
        (!requestHas ||
          (request.resource.data.bracketId == resource.data.bracketId &&
            request.resource.data.bracketMatchId == resource.data.bracketMatchId));
    }

    function hasBracketKeys() {
      return keysOnly([
        "id",
        "communityId",
        "participantProfileIds",
        "seedMethod",
        "teamSize",
        "gameType",
        "customGameDefinitionId",
        "customGameDefinitionName",
        "status",
        "rounds",
        "createdAt",
        "updatedAt"
      ]);
    }

    // Phase C — league board messages (`data-contracts.md`).
    function hasCommunityMessageKeysOnCreate() {
      let ks = request.resource.data.keys();
      return ks.hasOnly([
        "id",
        "communityId",
        "authorProfileId",
        "text",
        "createdAt",
        "updatedAt"
      ]) ||
        ks.hasOnly([
          "id",
          "communityId",
          "authorProfileId",
          "text",
          "deleted",
          "createdAt",
          "updatedAt"
        ]);
    }

    function communityMessageCreateValid(communityId, messageId) {
      return request.resource.data.id == messageId &&
        request.resource.data.communityId == communityId &&
        request.resource.data.authorProfileId == uid() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 4000 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!request.resource.data.keys().hasAny(["deleted"]) ||
          request.resource.data.deleted == false);
    }

    function hasGameDefinitionKeys() {
      return request.resource.data.keys().hasOnly([
        "id",
        "communityId",
        "name",
        "rulesText",
        "createdByProfileId",
        "createdAt",
        "updatedAt"
      ]);
    }

    match /profiles/{profileId} {
      allow read: if isOwnProfile(profileId);

      // Client can create/update own profile but cannot set server-owned fields.
      allow create: if isOwnProfile(profileId) &&
        hasProfileKeys() &&
        profileCreateOmitsServerOddsMaps() &&
        request.resource.data.id == profileId &&
        request.resource.data.googleAuthId == uid() &&
        request.resource.data.overallOdds == 0 &&
        request.resource.data.overallGamesPlayed == 0;

      allow update: if isOwnProfile(profileId) &&
        hasProfileKeys() &&
        profileUpdateServerOddsMapsImmutable() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.googleAuthId == resource.data.googleAuthId &&
        request.resource.data.overallOdds == resource.data.overallOdds &&
        request.resource.data.overallGamesPlayed == resource.data.overallGamesPlayed &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /communities/{communityId} {
      allow read: if isPlatformAdmin() || (
        isCommunityMember(communityId) && (
          resource.data.createdByProfileId == uid() ||
          !resource.data.keys().hasAny(['hiddenFromMembers']) ||
          resource.data.hiddenFromMembers == false
        )
      );

      // Created only by Cloud Functions (Admin SDK) so joins can enforce caps atomically.
      allow create: if false;

      // Creator may edit display name; memberCount / hiddenFromMembers change only via Admin (e.g. callables).
      allow update: if signedIn() &&
        hasCommunityDocumentKeys() &&
        communityHiddenPreserved() &&
        isCommunityMember(communityId) &&
        resource.data.createdByProfileId == uid() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.resource.data.inviteLink == resource.data.inviteLink &&
        communityMemberCountPreserved();

      allow delete: if false;

      match /messages/{messageId} {
        // Path already scopes `communityId`; create rules validate payload `communityId`.
        allow read: if isPlatformAdmin() || (
          isCommunityMember(communityId) &&
          !currentUserLeagueHiddenFromMembers(communityId)
        );

        allow create: if signedIn() &&
          hasCommunityMessageKeysOnCreate() &&
          communityMessageCreateValid(communityId, messageId) &&
          isCommunityMember(communityId) &&
          !currentUserLeagueHiddenFromMembers(communityId);

        // V1: no client edits; moderation via Admin SDK / Phase D callables.
        allow update, delete: if false;
      }

      match /gameDefinitions/{gameDefinitionId} {
        allow read: if isPlatformAdmin() || (
          isCommunityMember(communityId) &&
          !currentUserLeagueHiddenFromMembers(communityId)
        );

        // E1: custom game definitions are managed by trusted callables (Admin SDK).
        allow create, update, delete: if false;
      }
    }

    match /memberships/{membershipId} {
      // Own row always; others in same league only when this user is not blocked from that league.
      allow read: if isPlatformAdmin() || (
        signedIn() && (
          resource.data.profileId == uid() ||
          (isCommunityMember(resource.data.communityId) &&
            !currentUserLeagueHiddenFromMembers(resource.data.communityId))
        )
      );

      // Membership rows are created only by Cloud Functions (Admin SDK).
      allow create: if false;

      // Client cannot mutate membership once created (server can via Admin SDK).
      allow update, delete: if false;
    }

    match /gameLogs/{gameLogId} {
      allow read: if isPlatformAdmin() || (
        isCommunityMember(resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(resource.data.communityId)
      );

      allow create: if signedIn() &&
        hasGameLogKeys() &&
        gameLogBracketLinkValid(request.resource.data) &&
        gameLogMvpLvpValid(request.resource.data) &&
        gameLogGameTypeAndCustomValid(request.resource.data) &&
        request.resource.data.id == gameLogId &&
        request.resource.data.createdByProfileId == uid() &&
        isCommunityMember(request.resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(request.resource.data.communityId) &&
        request.resource.data.winnerProfileIds.size() > 0 &&
        request.resource.data.loserProfileIds.size() > 0 &&
        request.resource.data.photoUrls.size() == 1;

      // Only log creator can update/delete.
      allow update: if signedIn() &&
        hasGameLogKeys() &&
        gameLogBracketLinkValid(request.resource.data) &&
        gameLogBracketImmutabilityValid() &&
        gameLogMvpLvpValid(request.resource.data) &&
        gameLogGameTypeAndCustomValid(request.resource.data) &&
        gameLogGameTypeAndCustomImmutableOnUpdate() &&
        isCommunityMember(resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(resource.data.communityId) &&
        resource.data.createdByProfileId == uid() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.winnerProfileIds.size() > 0 &&
        request.resource.data.loserProfileIds.size() > 0 &&
        request.resource.data.photoUrls.size() == 1;

      allow delete: if signedIn() &&
        isCommunityMember(resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(resource.data.communityId) &&
        resource.data.createdByProfileId == uid();
    }

    match /brackets/{bracketId} {
      allow read: if isPlatformAdmin() || (
        isCommunityMember(resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(resource.data.communityId)
      );

      allow create: if signedIn() &&
        hasBracketKeys() &&
        request.resource.data.id == bracketId &&
        isCommunityMember(request.resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(request.resource.data.communityId);

      // Updates allowed only for community members.
      allow update: if signedIn() &&
        hasBracketKeys() &&
        isCommunityMember(resource.data.communityId) &&
        !currentUserLeagueHiddenFromMembers(resource.data.communityId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // D3 audit log: append-only via Admin SDK callables/triggers.
    // Clients cannot write; platform admins may read for accountability.
    match /adminActions/{adminActionId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }
  }
}
