[debug] [2026-03-25T05:30:28.672Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/bitchcup-dev/rulesets {"name":"projects/bitchcup-dev/rulesets/1db47713-cd06-4707-af1d-596e463847f6","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    /**\n     * Assumption for rules:\n     * - profileId == request.auth.uid\n     * - membership doc id = \"{communityId}_{profileId}\"\n     *\n     * If you use UUID profile IDs instead, add a profile->uid mapping strategy\n     * that can be checked in rules.\n     */\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function uid() {\n      return request.auth.uid;\n    }\n\n    function isOwnProfile(profileId) {\n      return signedIn() && uid() == profileId;\n    }\n\n    function membershipIdFor(communityId, profileId) {\n      return communityId + \"_\" + profileId;\n    }\n\n    function isCommunityMember(communityId) {\n      return signedIn() &&\n        exists(\n          /databases/$(database)/documents/memberships/$(membershipIdFor(communityId, uid()))\n        );\n    }\n\n    function keysOnly(allowed) {\n      return request.resource.data.keys().hasOnly(allowed);\n    }\n\n    function hasProfileKeys() {\n      return keysOnly([\n        \"id\",\n        \"googleAuthId\",\n        \"displayName\",\n        \"profilePhotoUrl\",\n        \"overallOdds\",\n        \"overallGamesPlayed\",\n        \"ageConfirmed21PlusAt\",\n        \"onboardingCompleteAt\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]);\n    }\n\n    // Callable-created communities include memberCount; older docs may omit it until backfilled.\n    function hasCommunityKeys() {\n      return request.resource.data.keys().hasOnly([\n        \"id\",\n        \"name\",\n        \"createdByProfileId\",\n        \"inviteCode\",\n        \"inviteLink\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]) || request.resource.data.keys().hasOnly([\n        \"id\",\n        \"name\",\n        \"createdByProfileId\",\n        \"inviteCode\",\n        \"inviteLink\",\n        \"memberCount\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]);\n    }\n\n    function communityMemberCountPreserved() {\n      return (!resource.data.keys().hasAny([\"memberCount\"]) && !request.resource.data.keys().hasAny([\"memberCount\"])) ||\n        request.resource.data.memberCount == resource.data.memberCount;\n    }\n\n    function hasGameLogKeys() {\n      return keysOnly([\n        \"id\",\n        \"communityId\",\n        \"bracketId\",\n        \"bracketMatchId\",\n        \"gameType\",\n        \"createdByProfileId\",\n        \"participantProfileIds\",\n        \"winnerProfileIds\",\n        \"loserProfileIds\",\n        \"mvpProfileId\",\n        \"lvpProfileId\",\n        \"photoUrls\",\n        \"notes\",\n        \"pongStats\",\n        \"beerBallStats\",\n        \"battlePongStats\",\n        \"baseballStats\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]);\n    }\n\n    // MVP/LVP optional; when set must be a participant and must differ from each other.\n    function gameLogMvpLvpValid(data) {\n      let mvpOk = !data.keys().hasAny([\"mvpProfileId\"]) ||\n        data.mvpProfileId == null ||\n        (data.mvpProfileId is string && data.participantProfileIds.hasAny([data.mvpProfileId]));\n      let lvpOk = !data.keys().hasAny([\"lvpProfileId\"]) ||\n        data.lvpProfileId == null ||\n        (data.lvpProfileId is string && data.participantProfileIds.hasAny([data.lvpProfileId]));\n      let notSame = data.mvpProfileId == null || data.lvpProfileId == null ||\n        data.mvpProfileId != data.lvpProfileId;\n      return mvpOk && lvpOk && notSame;\n    }\n\n    // Optional bracket linkage:\n    // - either both keys are absent\n    // - or both keys are present as non-empty strings\n    // Client must not set only one of the two.\n    function gameLogBracketLinkValid(data) {\n      let hasBracketId = data.keys().hasAny([\"bracketId\"]);\n      let hasBracketMatchId = data.keys().hasAny([\"bracketMatchId\"]);\n      return (!hasBracketId && !hasBracketMatchId) ||\n        (hasBracketId && hasBracketMatchId &&\n          data.bracketId is string && data.bracketId != \"\" &&\n          data.bracketMatchId is string && data.bracketMatchId != \"\");\n    }\n\n    // V1 rule: bracket linkage is immutable after creation.\n    // Deny adding or removing bracket keys via update.\n    function gameLogBracketImmutabilityValid() {\n      let resourceHas = resource.data.keys().hasAny([\"bracketId\"]);\n      let requestHas = request.resource.data.keys().hasAny([\"bracketId\"]);\n      return resourceHas == requestHas &&\n        (!requestHas ||\n          (request.resource.data.bracketId == resource.data.bracketId &&\n            request.resource.data.bracketMatchId == resource.data.bracketMatchId));\n    }\n\n    function hasBracketKeys() {\n      return keysOnly([\n        \"id\",\n        \"communityId\",\n        \"participantProfileIds\",\n        \"seedMethod\",\n        \"teamSize\",\n        \"status\",\n        \"rounds\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]);\n    }\n\n    match /profiles/{profileId} {\n      allow read: if isOwnProfile(profileId);\n\n      // Client can create/update own profile but cannot set server-owned fields.\n      allow create: if isOwnProfile(profileId) &&\n        hasProfileKeys() &&\n        request.resource.data.id == profileId &&\n        request.resource.data.googleAuthId == uid() &&\n        request.resource.data.overallOdds == 0 &&\n        request.resource.data.overallGamesPlayed == 0;\n\n      allow update: if isOwnProfile(profileId) &&\n        hasProfileKeys() &&\n        request.resource.data.id == resource.data.id &&\n        request.resource.data.googleAuthId == resource.data.googleAuthId &&\n        request.resource.data.overallOdds == resource.data.overallOdds &&\n        request.resource.data.overallGamesPlayed == resource.data.overallGamesPlayed &&\n        request.resource.data.createdAt == resource.data.createdAt;\n\n      allow delete: if false;\n    }\n\n    match /communities/{communityId} {\n      allow read: if isCommunityMember(communityId);\n\n      // Created only by Cloud Functions (Admin SDK) so joins can enforce caps atomically.\n      allow create: if false;\n\n      // Creator may edit display name; memberCount changes only via Admin (e.g. join callable).\n      allow update: if signedIn() &&\n        hasCommunityKeys() &&\n        isCommunityMember(communityId) &&\n        resource.data.createdByProfileId == uid() &&\n        request.resource.data.id == resource.data.id &&\n        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.inviteCode == resource.data.inviteCode &&\n        request.resource.data.inviteLink == resource.data.inviteLink &&\n        communityMemberCountPreserved();\n\n      allow delete: if false;\n    }\n\n    match /memberships/{membershipId} {\n      // User can read only their own membership docs.\n      allow read: if signedIn() && (\n        resource.data.profileId == uid() || isCommunityMember(resource.data.communityId)\n      );\n\n      // Membership rows are created only by Cloud Functions (Admin SDK).\n      allow create: if false;\n\n      // Client cannot mutate membership once created (server can via Admin SDK).\n      allow update, delete: if false;\n    }\n\n    match /gameLogs/{gameLogId} {\n      allow read: if isCommunityMember(resource.data.communityId);\n\n      allow create: if signedIn() &&\n        hasGameLogKeys() &&\n        gameLogBracketLinkValid(request.resource.data) &&\n        gameLogMvpLvpValid(request.resource.data) &&\n        request.resource.data.id == gameLogId &&\n        request.resource.data.createdByProfileId == uid() &&\n        isCommunityMember(request.resource.data.communityId) &&\n        request.resource.data.winnerProfileIds.size() > 0 &&\n        request.resource.data.loserProfileIds.size() > 0 &&\n        request.resource.data.photoUrls.size() == 1;\n\n      // Only log creator can update/delete.\n      allow update: if signedIn() &&\n        hasGameLogKeys() &&\n        gameLogBracketLinkValid(request.resource.data) &&\n        gameLogBracketImmutabilityValid() &&\n        gameLogMvpLvpValid(request.resource.data) &&\n        isCommunityMember(resource.data.communityId) &&\n        resource.data.createdByProfileId == uid() &&\n        request.resource.data.id == resource.data.id &&\n        request.resource.data.communityId == resource.data.communityId &&\n        request.resource.data.createdByProfileId == resource.data.createdByProfileId &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.winnerProfileIds.size() > 0 &&\n        request.resource.data.loserProfileIds.size() > 0 &&\n        request.resource.data.photoUrls.size() == 1;\n\n      allow delete: if signedIn() &&\n        isCommunityMember(resource.data.communityId) &&\n        resource.data.createdByProfileId == uid();\n    }\n\n    match /brackets/{bracketId} {\n      allow read: if isCommunityMember(resource.data.communityId);\n\n      allow create: if signedIn() &&\n        hasBracketKeys() &&\n        request.resource.data.id == bracketId &&\n        isCommunityMember(request.resource.data.communityId);\n\n      // Updates allowed only for community members.\n      allow update: if signedIn() &&\n        hasBracketKeys() &&\n        isCommunityMember(resource.data.communityId) &&\n        request.resource.data.id == resource.data.id &&\n        request.resource.data.communityId == resource.data.communityId &&\n        request.resource.data.createdAt == resource.data.createdAt;\n\n      allow delete: if false;\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-03-25T05:30:28.603343Z","metadata":{"services":["cloud.firestore"]}}
